# ---------------------------------------------------------------------------
# ZapTask Platform API
# One key, only ever used server-side — never shipped to the browser.
#
#   zp_live_…  ZapProperty portal key (recommended). Generated on the ZapTask
#              server with `php artisan zapproperty:key` and set there as
#              ZAPPROPERTY_API_KEY. Returns every listing an agent has published
#              with "Show on ZapProperty", across ALL companies.
#   zt_live_…  A company API key (ZapTask → Settings → Platform → Platform API
#              keys). Sees that one company's sites only; needs `assets.read`
#              (+ `tasks.read` / `tasks.write` for the task panel).
# ---------------------------------------------------------------------------
ZAPTASK_BASE_URL=https://app.zaptask.co.uk
ZAPTASK_API_KEY=zp_live_replace_me

# Normally inferred from the key prefix. Force `platform` or `company` if your
# key was minted without the conventional prefix.
ZAPTASK_API_SCOPE=

# Company keys only: the company API has no "published" filter, so it is
# applied here. Set to `true` to also show sites with the box unticked (they
# are labelled "Not published" in the UI). Ignored with a portal key.
ZAPTASK_INCLUDE_UNLISTED=false

# Optional extra restriction to one ZapTask asset type (property, building,
# unit, site, …). Leave blank to accept any type the agent has published.
ZAPTASK_ASSET_TYPE=

# Maximum number of assets to pull from ZapTask (paginated at 100/page).
ZAPTASK_MAX_ASSETS=1000

# Run with built-in sample properties instead of calling ZapTask.
# Handy for trying the UI before you have an API key.
ZAPTASK_DEMO=false

# ---------------------------------------------------------------------------
# Mapbox
# Public token (pk.…) used in the browser for the map and place search.
# Scope it to your domain in the Mapbox dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me

# Optional: a separate token for server-side geocoding of property addresses.
# Falls back to NEXT_PUBLIC_MAPBOX_TOKEN when unset.
MAPBOX_SERVER_TOKEN=

# Bias address geocoding to a country (ISO 3166-1 alpha-2). Blank = worldwide.
GEOCODE_COUNTRY=gb

# Optional: after geocoding an address, write the coordinates back to the
# asset's `metadata.geo` in ZapTask so they never need geocoding again.
# Company keys only (requires `assets.write`); the portal is read-only.
ZAPTASK_WRITE_BACK_GEOCODE=false
