# ---------------------------------------------------------------------------
# ZapTask Platform API
# Create a key in ZapTask: Settings → Platform → Platform API keys.
# The key needs `assets.read` (and `tasks.read` / `tasks.write` if you want the
# per-property task list and "Create task" action). It is only ever used
# server-side — it is never shipped to the browser.
# ---------------------------------------------------------------------------
ZAPTASK_BASE_URL=https://app.zaptask.co.uk
ZAPTASK_API_KEY=zt_live_replace_me

# Which sites appear is decided by the agent's "Show on ZapProperty" checkbox
# on each site in ZapTask. Set to `true` to also show sites with it unticked
# (they are labelled "Not published" in the UI).
ZAPTASK_INCLUDE_UNLISTED=false

# Optional extra restriction to one ZapTask asset type (property, building,
# unit, site, …). Leave blank to accept any type the agent has published.
ZAPTASK_ASSET_TYPE=

# Maximum number of assets to pull from ZapTask (paginated at 100/page).
ZAPTASK_MAX_ASSETS=1000

# Run with built-in sample properties instead of calling ZapTask.
# Handy for trying the UI before you have an API key.
ZAPTASK_DEMO=false

# ---------------------------------------------------------------------------
# Mapbox
# Public token (pk.…) used in the browser for the map and place search.
# Scope it to your domain in the Mapbox dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me

# Optional: a separate token for server-side geocoding of property addresses.
# Falls back to NEXT_PUBLIC_MAPBOX_TOKEN when unset.
MAPBOX_SERVER_TOKEN=

# Bias address geocoding to a country (ISO 3166-1 alpha-2). Blank = worldwide.
GEOCODE_COUNTRY=gb

# Optional: after geocoding an address, write the coordinates back to the
# asset's `metadata.geo` in ZapTask so they never need geocoding again.
# Requires `assets.write` on the API key.
ZAPTASK_WRITE_BACK_GEOCODE=false
